@using EmployeeListApp.Services
@using EmployeeListApp.Data

@page "/employees"
@inject EmployeesService EmployeesService

<h3>Employees</h3>

@if (employees == null)
{
<p>Učitavanje...</p>
}
else if (!employees.Any())
{
<p>Nema zaposlenika.</p>
}
else
{
<table class="table">
    <thead>
        <tr>
            <th>Ime i prezime</th>
            <th>Odjel</th>
            <th>Plaća</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in employees)
                {
        <tr>
            <td>@e.FullName</td>
            <td>@e.Department</td>
            <td>@e.Salary</td>
        </tr>
                }
    </tbody>
</table>

    @code {
    private List<Employee> employees;

    public Employees()
    {
    }

    protected override async Task OnInitializedAsync()
    {
        employees = await EmployeesService.GetAllAsync();
    }
}
}
