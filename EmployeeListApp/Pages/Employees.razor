@page "/employees"
@using EmployeeListApp.Data
@using EmployeeListApp.Services
@inject EmployeesService EmployeesService

<h3>Employees</h3>

<div class="mb-3">
    <input class="form-control" placeholder="Full name" @bind="newEmployee.FullName" />
</div>
<div class="mb-3">
    <input class="form-control" placeholder="Department" @bind="newEmployee.Department" />
</div>
<div class="mb-3">
    <input class="form-control" placeholder="Salary" type="number" step="0.01" @bind="newEmployee.Salary" />
</div>

<button class="btn btn-primary" @onclick="AddEmployee">Add</button>

<hr />

@if (employees == null)
{
    <p>Loading...</p>
}
else if (!employees.Any())
{
    <p>No employees found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Full name</th>
                <th>Department</th>
                <th>Salary</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in employees)
            {
                <tr>
                    <td>@e.FullName</td>
                    <td>@e.Department</td>
                    <td>@e.Salary</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Employee>? employees;
    private Employee newEmployee = new();

    protected override async Task OnInitializedAsync()
    {
        employees = await EmployeesService.GetAllAsync();
    }

    private async Task AddEmployee()
    {
        await EmployeesService.AddAsync(newEmployee);
        newEmployee = new Employee();
        employees = await EmployeesService.GetAllAsync();
    }
}
