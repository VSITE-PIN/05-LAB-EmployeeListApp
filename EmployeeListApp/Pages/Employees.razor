@page "/employees"
@using EmployeeListApp.Data
@inject EmployeeListApp.Services.EmployeesService EmployeesService

<h3>Employees</h3>

@if (employees == null)
{
    <p><em>Loading...</em></p>
}
else if (employees.Count == 0)
{
    <p>Nema zaposlenika u bazi.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Full name</th>
                <th>Department</th>
                <th>Salary</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in employees)
            {
                <tr>
                    <td>@e.Id</td>
                    <td>@e.FullName</td>
                    <td>@e.Department</td>
                    <td>@e.Salary</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Employee>? employees;

    protected override async Task OnInitializedAsync()
    {
        employees = await EmployeesService.GetEmployeesAsync();
    }
}
