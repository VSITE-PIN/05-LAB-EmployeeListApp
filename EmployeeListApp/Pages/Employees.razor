@page "/employees"
@inject EmployeeListApp.Services.EmployeesService EmployeesService

<h3>Popis zaposlenika</h3>

@if (employees == null)
{
    <p>Učitavanje...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Ime i prezime</th>
                <th>Odjel</th>
                <th>Plaća</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in employees)
            {
                <tr>
                    <td>@e.Id</td>
                    <td>@e.FullName</td>
                    <td>@e.Department</td>
                    <td>@e.Salary</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<EmployeeListApp.Data.Employee> employees;

    protected override async Task OnInitializedAsync()
    {
        employees = await EmployeesService.GetAllAsync();
    }
}
